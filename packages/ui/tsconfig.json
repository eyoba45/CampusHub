{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    // Silence the deprecation warning for now
    "ignoreDeprecations": "6.0",

    // Explicit path mappings for your UI package
    "paths": {
      "@workspace/ui": ["./src/index.ts"],
      "@workspace/ui/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
